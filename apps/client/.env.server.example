# Local compatibility server: Engine API and Live WebSocket in one process.
DATABASE_URL=sqlite:photon.db?mode=rwc
PORT=3001

# Production Engine server: durable sync API only.
# `tidb://...` is accepted by Photon and normalized to the MySQL driver at startup.
PHOTON_ENGINE_PORT=3001
PHOTON_ENGINE_APP_DATABASE_URL=sqlite:photon-engine-app.db?mode=rwc
PHOTON_ENGINE_DATABASE_URL=tidb://<user>:<password>@<tidb-host>:4000/photon

# Production Live server: realtime WebSocket only.
# Keep this SQLite unless Live needs durable Yjs room persistence in the target runtime.
PHOTON_LIVE_PORT=3002
PHOTON_LIVE_DATABASE_URL=sqlite:photon-live.db?mode=rwc
PHOTON_LIVE_ENGINE_DATABASE_URL=tidb://<user>:<password>@<tidb-host>:4000/photon

# Engine mounted on library-api (de-vendoring Stage 4). This is the endpoint
# apps/client already posts to; the standalone Engine server above is the local
# alternative. Set on the library-api deployment, not here.
#   LIBRARY_PHOTON_ENGINE_ENABLED=true
#   LIBRARY_PHOTON_ENGINE_TENANT=library
# The Engine reuses library-api's own DATABASE_URL -- there is no separate
# engine DSN to configure, and no separate pool.

# Manual Engine API smoke test target.
PHOTON_ENGINE_SMOKE_URL=http://127.0.0.1:3001
# Scope must be tenant:{tenant}:workspace:{workspace}; the tenant has to match
# the server's (`library` for library-api, `photon` for a standalone server).
PHOTON_ENGINE_SMOKE_SCOPE=tenant:library:workspace:smoke
# library-api requires an authenticated caller on /api/engine/*. Set a Cognito
# access token when pointing the smoke test at a library-api deployment.
PHOTON_ENGINE_SMOKE_TOKEN=
