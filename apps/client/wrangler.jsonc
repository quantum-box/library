{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "library-client-sync",
  "main": "workers/sync/index.ts",
  "compatibility_date": "2026-05-05",
  // Quantum Box, Inc. The deploying account has a personal account too, and
  // wrangler cannot pick between them non-interactively.
  "account_id": "fef3f6ef891ab3e121deb43eeb57318a",
  "vars": {
    // The Engine the edge proxies `/api/engine/*` to. library-api serves those
    // routes itself (`apps/api/src/photon_engine.rs`), and it is also what the
    // browser posts to directly -- `kitConfig`'s engine transport is built on
    // `server.apiBaseUrl`, not on the Live origin -- so the two must name the
    // same Engine or a push through the edge would land somewhere else.
    "PHOTON_CLOUD_ENGINE_BASE_URL": "https://library-api.txcloud.app",
    // Production rollout and PropertyValue parity verified on 2026-09-05.
    // Preview deployments use their separate, opt-in configuration.
    "PHOTON_LIVE_ENABLED": "true",
    "PHOTON_LIVE_ALLOWED_ORIGINS": "https://planetlibrary.txcloud.app,https://library-client.txcloud.app",
    "PHOTON_LIVE_API_BASE_URL": "https://library-api.txcloud.app"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PHOTON_SYNC_ROOMS",
        "class_name": "PhotonSyncRoom"
      },
      {
        "name": "PHOTON_LIVE_ROOMS",
        "class_name": "PhotonLiveRoom"
      },
      {
        "name": "PHOTON_LIVE_TICKETS",
        "class_name": "PhotonLiveTicketStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PhotonSyncRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PhotonLiveRoom", "PhotonLiveTicketStore"]
    }
  ]
}
