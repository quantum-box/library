{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Library Client",
  "version": "../package.json",
  "identifier": "com.quantumbox.library.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run pages:build"
  },
  "app": {
    "windows": [
      {
        "title": "Library Client",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "child-src": "'self' blob:",
        "connect-src": "'self' blob: ipc: http://ipc.localhost https://cognito-idp.ap-northeast-1.amazonaws.com https://api.n1.tachy.one https://library.api.n1.tachy.one https://library-api.txcloud.app wss://photon-sync.quantum-box.workers.dev",
        "font-src": "'self' data:",
        "form-action": "'self'",
        "frame-src": "'none'",
        "img-src": "'self' blob: data: https:",
        "object-src": "'none'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      },
      "devCsp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "child-src": "'self' blob:",
        "connect-src": "'self' blob: ipc: http://ipc.localhost http://localhost:3001 http://127.0.0.1:3001 http://localhost:50053 http://127.0.0.1:50053 ws: wss: https://cognito-idp.ap-northeast-1.amazonaws.com https://api.n1.tachy.one https://library.api.n1.tachy.one https://library-api.txcloud.app",
        "font-src": "'self' data:",
        "form-action": "'self'",
        "frame-src": "'none'",
        "img-src": "'self' blob: data: https:",
        "object-src": "'none'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/quantum-box/library/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0ODMxNjZDQjFGOURBREYKUldUZjJ2bXhiQmFEOUFjWFRWV3N5QndYOCtUZTVac2FzQU1tSlpQZVBpZXFLQ2ZuOUprWEdLRnYK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "iOS": {
      "developmentTeam": "J8429VCGMR",
      "minimumSystemVersion": "14.0"
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
