# Library API
VITE_LIBRARY_API_BASE_URL=http://127.0.0.1:50053
VITE_LIBRARY_PLATFORM_ID=tn_01j702qf86pc2j35s0kv0gv3gy

# Cognito authentication. The app client must allow USER_PASSWORD_AUTH.
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=ap-northeast-1

# Keep manual token entry out of normal builds. Enable only for local debugging.
VITE_ENABLE_DEV_TOKEN_AUTH=false

# Optional realtime/local-first endpoints
VITE_LIBRARY_DEPLOYMENT_MODE=local
VITE_LIBRARY_SYNC_BACKEND=rust-server
VITE_LIBRARY_SYNC_WS_URL=ws://127.0.0.1:3001/ws
