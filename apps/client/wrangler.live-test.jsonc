{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "library-data-live-e2e",
  "main": "workers/sync/build/index.js",
  "build": {
    "command": "npm run build:worker",
    "watch_dir": ["workers/sync/src", "workers/common/src", "workers/Cargo.toml", "workers/Cargo.lock"]
  },
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }],
  "compatibility_date": "2026-05-05",
  "vars": {
    "PHOTON_LIVE_ENABLED": "true",
    "EXTERNAL_SYNC_SCANNER_ENABLED": "false",
    "PHOTON_LIVE_API_BASE_URL": "http://127.0.0.1:50063",
    "PHOTON_LIVE_ALLOWED_ORIGINS": "http://127.0.0.1:5187"
  },
  "durable_objects": {
    "bindings": [
      { "name": "PHOTON_SYNC_ROOMS", "class_name": "PhotonSyncRoom" },
      { "name": "PHOTON_LIVE_ROOMS", "class_name": "PhotonLiveRoom" },
      { "name": "PHOTON_LIVE_TICKETS", "class_name": "PhotonLiveTicketStore" },
      { "name": "EXTERNAL_SYNC_DISPATCH", "class_name": "ExternalSyncDispatcher" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PhotonSyncRoom", "PhotonLiveRoom", "PhotonLiveTicketStore"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ExternalSyncDispatcher"]
    }
  ]
}
