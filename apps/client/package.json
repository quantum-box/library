{
  "name": "@quantum-box/library-client",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "files": [
    "dist/package",
    "src/index.css",
    "README.md",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/package/src/platform/config.d.ts",
      "default": "./dist/package/src/platform/config.js"
    },
    "./config": {
      "types": "./dist/package/src/platform/config.d.ts",
      "default": "./dist/package/src/platform/config.js"
    },
    "./router": {
      "types": "./dist/package/src/platform/router.d.ts",
      "default": "./dist/package/src/platform/router.js"
    },
    "./sync": {
      "types": "./dist/package/src/platform/sync.d.ts",
      "default": "./dist/package/src/platform/sync.js"
    },
    "./server-contract": {
      "types": "./dist/package/src/platform/server-contract.d.ts",
      "default": "./dist/package/src/platform/server-contract.js"
    },
    "./worker": {
      "types": "./dist/package/workers/sync/index.d.ts",
      "default": "./dist/package/workers/sync/index.js"
    },
    "./styles.css": "./src/index.css"
  },
  "scripts": {
    "dev": "vite",
    "dev:cf-sync": "VITE_PHOTON_SYNC_WS_URL=ws://127.0.0.1:8787/ws vite",
    "build": "npm run engine:wasm && tsc -b && vite build",
    "build:cloud": "npm run build:package && tsc -b && vite build",
    "build:package": "tsc -p tsconfig.package.json && tsc -p tsconfig.package.worker.json",
    "lint": "eslint .",
    "prepare": "npm run build:package",
    "type-check": "tsc -b --noEmit",
    "type-check:worker": "tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "fixtures:blocknote": "UPDATE_FIXTURES=1 vitest run src/test/blocknoteFixtures.test.ts",
    "test-storybook": "vitest --config vitest.storybook.config.ts --project=storybook",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build",
    "tauri:ios:build:sim": "tauri ios build --target aarch64-sim",
    "engine:wasm": "node scripts/build-photon-wasm.mjs",
    "server": "cd packages/server && cargo run --bin photon-server",
    "server:engine": "cd packages/server && cargo run --bin photon-engine-server",
    "server:live": "cd packages/server && cargo run --bin photon-live-server",
    "server:engine:smoke": "node scripts/smoke-engine-api.mjs",
    "library:api:verify": "node scripts/verify-library-api-connection.mjs",
    "server:test": "cargo test --manifest-path packages/server/Cargo.toml",
    "pages:build": "npm run build",
    "pages:deploy": "npm run pages:build && cd dist && wrangler pages deploy . --project-name library-client --branch main --commit-dirty=true",
    "worker:dev": "wrangler dev --config wrangler.jsonc --port 8787",
    "worker:deploy": "wrangler deploy --config wrangler.jsonc",
    "mock:tachyon": "cd packages/server && cargo run --bin mock-tachyon-api"
  },
  "dependencies": {
    "@blocknote/code-block": "^0.50.0",
    "@blocknote/core": "^0.50.0",
    "@blocknote/react": "^0.50.0",
    "@blocknote/shadcn": "^0.50.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@electric-sql/pglite": "^0.4.5",
    "@quantum-box/photon": "^0.2.0",
    "@tachyon-sdk/native-ui": "https://codeload.github.com/quantum-box/native-ui/tar.gz/f2c2d704e61c321c8b73d5e2e35d5de104bfd3be",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-router": "^1.168.10",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.23",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xyflow/react": "^12.10.2",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.525.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "xlsx": "^0.18.5",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260505.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.6",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "storybook": "^10.3.6",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.2",
    "wrangler": "^4.87.0",
    "ws": "^8.18.0"
  }
}
