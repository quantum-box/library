DATABASE_URL=mysql://root:@localhost:15000/library
# GitHub App OAuth (optional - for GitHub sync feature)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5010/oauth/github/callback

# MCP OAuth facade (optional - used by /mcp browser auth)
LIBRARY_API_BASE_URL=http://localhost:50053
# Library client (apps/client) origin reported as `url` on public data
# responses. Not apps/web -- public URLs point at the client only.
LIBRARY_CLIENT_BASE_URL=http://localhost:5173
MCP_AUTH_REQUIRED=true
MCP_COGNITO_CLIENT_ID=
MCP_COGNITO_REGION=ap-northeast-1
