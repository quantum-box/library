{
  "name": "library",
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@4.4.1",
  "workspaces": [
    "apps/web",
    "apps/user-guide"
  ],
  "scripts": {
    "dev": "yarn workspace library-web dev",
    "client:dev": "npm --prefix apps/client run dev",
    "client:build": "npm --prefix apps/client run build",
    "client:test": "npm --prefix apps/client run test",
    "client:type-check": "npm --prefix apps/client run type-check",
    "build": "yarn workspace library-web build",
    "lint": "yarn workspace library-web lint",
    "test": "yarn workspace library-web test",
    "test:e2e": "yarn workspace library-web test:e2e",
    "tsc": "yarn workspace library-web ts",
    "smoke:library-rest-e2e": "scripts/library-rest-e2e-smoke.sh",
    "check:rust-workspace-cycles": "node scripts/check-rust-workspace-cycles.mjs",
    "guide:dev": "yarn workspace library-user-guide dev",
    "guide:build": "yarn workspace library-user-guide build"
  },
  "resolutions": {
    "webpack": "5.101.2",
    "tailwindcss": "3.4.17",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "vitest": "^3.1.1"
  }
}
